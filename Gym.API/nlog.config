<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <!--
    The application logs through Microsoft.Extensions.Logging (ILogger). NLog is wired in
    underneath by Program.cs, so no layer references NLog directly.
    Every line carries the CorrelationId pushed by CorrelationIdMiddleware.
  -->

  <targets>
    <target xsi:type="File" name="allfile"
            fileName="${basedir}/logs/gym-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|cid=${scopeproperty:item=CorrelationId:whenEmpty=-}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}"
            keepFileOpen="true"
            concurrentWrites="true"
            archiveEvery="Day"
            maxArchiveFiles="14" />

    <target xsi:type="File" name="ownfile"
            fileName="${basedir}/logs/gym-app-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|cid=${scopeproperty:item=CorrelationId:whenEmpty=-}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}" />

    <target xsi:type="ColoredConsole" name="console"
            layout="${time}|${level:uppercase=true}|cid=${scopeproperty:item=CorrelationId:whenEmpty=-}|${logger:shortName=true}|${message}${onexception:${newline}${exception:format=message}}" />
  </targets>

  <rules>
    <!-- Framework noise: warnings and above only, and never to the app-only file. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Debug" writeTo="ownfile" />
    <logger name="*" minlevel="Info" writeTo="allfile,console" />
  </rules>
</nlog>
